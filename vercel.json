{
  "buildCommand": "npm run build",
  "outputDirectory": "app/web/dist",
  "functions": {
    "api/[[...path]].ts": {
      "includeFiles": ["server.ts"]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[[...path]].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/app/web/dist/index.html" }
  ]
}